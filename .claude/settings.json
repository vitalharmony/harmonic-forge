{
  "permissions": {
    "allow": [
      "CronCreate"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /home*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /boot*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane1_status_claims.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane2_status_claims.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_irreversible_ops.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/batch_gate.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/deny_lane3_ae_self_post.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_raw_board_scan.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/guard_gh_rest_budget.py\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/enforce_gate_ci_on_raw_post.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_data_migration_close.py\"",
            "timeout": 25,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_missing_preclose_inspection.py\"",
            "timeout": 25,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_route_tightened_merge.py\"",
            "timeout": 25,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_gate_and_write_same_command.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_undetermined_phase_close.py\"",
            "timeout": 25,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_unchecked_push.py\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/precheck_gate.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/block_blind_repeat.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane1_status_claims.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Monitor|CronCreate|Skill|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_belt_arming.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/deny_retired_belt_sweep.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/precheck_store_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/worktree_busy_guard.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Write|Edit|MultiEdit|NotebookEdit|CronCreate|ScheduleWakeup|RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/auto_ae_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/afk_defer.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/deny_cross_session_contact.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/compaction_reload_probe.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/require_ci_plan.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/gate_feedback_memory_write.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/expand_lane_shorthand.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/surface_dry_run_failures.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/grant_loop_override.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/grant_ci_plan_override.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/auto_ae_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/afk_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_model_trigger_check.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_session_model.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/compaction_marker.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/transaction_log_context.py\"; [ -f \"$f\" ] && python3 \"$f\" --boundary recent:30 || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/belt_wakeup.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/report_red_main.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/transaction_log_context.py\"; [ -f \"$f\" ] && python3 \"$f\" --boundary recent:30 || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/hooks/block_batch_stop.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_handoff_owed.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_model_stop_backstop.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_downshift_reminder.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "CronCreate|CronDelete",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_belt_arming.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_tasklist_post.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/report_open_dependents_on_close.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_precheck_outcome.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_tasklist_post.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_failed_command.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_precheck_outcome.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
