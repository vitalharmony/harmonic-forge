[Unit]
Description=Harmonic Forge: extract lane markers from issue threads into telemetry, a window from the last successful run (harmonic-forge#907)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/harmonic-forge/tools/telemetry/thread_extract_job.py
StandardOutput=append:%h/Harmonic_Projects/logs/forge-thread-extract.log
StandardError=append:%h/Harmonic_Projects/logs/forge-thread-extract.log
