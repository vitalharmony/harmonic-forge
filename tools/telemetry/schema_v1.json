{
  "name": "events",
  "version": 1,
  "adr": "docs/decisions/ADR-009-telemetry-event-store.md",
  "partitioning": ["account", "org", "source", "ts_month"],
  "required": ["event_id", "ts", "source", "account", "org", "event_type", "schema_version"],
  "columns": {
    "schema_version": "int",
    "event_id": "string: sha256(source, subject_id, event_type, ts)",
    "ts": "string: ISO 8601 UTC",
    "source": ["gh-thread", "gh-timeline", "gh-pr", "git", "hook", "belt", "memory-store", "registry", "advisory", "manual", "archive"],
    "account": "string: registry account, or 'unresolved'",
    "org": "string: owner segment of the normalized repo, or 'unresolved'",
    "repo": "string|null: normalized owner/name",
    "issue": "int|null",
    "pr": "int|null",
    "sha": "string|null",
    "actor": "string: lane1|lane2|lane3|operator|advisory:<name>|belt|hook:<script>|unset",
    "event_type": "string",
    "subject_kind": "string|null",
    "subject_id": "string|null",
    "attrs": "object<string,string>: ids, kinds, verdicts, counts -- never bodies",
    "provenance": ["footer", "heading", "token", "git-subject", "pr-link-marker", "timeline", "hook", "manual", "archive"],
    "validated": "bool",
    "extractor_version": "string"
  }
}
