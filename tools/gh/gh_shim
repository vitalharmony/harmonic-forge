#!/usr/bin/env python3
"""`~/.local/bin/gh` shim (harmonic-forge#650) -- the second of two
independent REST-budget-exhaustion guards.

WHY A SHIM AND NOT ONLY A HOOK
---------------------------------
`tools/hooks/guard_gh_rest_budget.py` catches a scan-shaped `gh` command
typed directly into a Bash tool call. It cannot see a `gh` invocation made
from *inside* a running script via `subprocess` -- by the time that runs,
there is no shell command for a `PreToolUse` hook to inspect. Installed via
`tools/gh/install_gh_shim.sh` at `~/.local/bin/gh` (ahead of the real `gh`
on PATH), this script IS `gh` for every caller, script or interactive alike,
so it sees every invocation regardless of how it was launched.

FAIL OPEN, ALWAYS
---------------------
A bug in this shim must never brick `gh` entirely -- see the broad
try/except around all pattern-module usage below. Anything unexpected
degrades to "run the real gh", never to a hang or a crash.
"""

from __future__ import annotations

import os
import sys
from datetime import datetime, timezone


def _self_realpath() -> str:
    return os.path.realpath(os.path.abspath(__file__))


def _resolve_real_gh() -> str:
    self_real = _self_realpath()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "gh")
        if not os.path.isfile(candidate):
            continue
        try:
            real = os.path.realpath(candidate)
        except OSError:
            continue
        if real != self_real:
            return candidate
    return "/usr/bin/gh"


#: harmonic-forge#964: callers whose scans are sanctioned, by the
#: `GH_SHIM_CALLER` marker they set. `item_list_cache` throttles its own
#: board reads; `batch_preflight` finds an issue's PR by branch prefix;
#: `l1_post` reads one branch's open PR (`pulls?head=`).
SANCTIONED_CALLERS = frozenset({"item_list_cache", "batch_preflight", "l1_post"})


def main() -> None:
    argv = sys.argv[1:]
    real_gh = _resolve_real_gh()

    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import gh_scan_patterns  # noqa: PLC0415 -- imported lazily so an import
        # failure alone can never prevent falling through to the real `gh`.

        # harmonic-forge#804: the per-project identity assertion (`gh api user --jq
        # .login`) is the first `gh` call of every lane entrypoint. It is exempt from
        # EVERYTHING below and short-circuits BEFORE the override is consumed:
        # consuming it here would spend the operator's one-shot grant on a call that
        # needed none, leaving the scan it was `touch`ed for still refused (preclose
        # finding), and a low REST budget must not block every post at its first line.
        # harmonic-forge#957 AC6: gh-as's token-fingerprint read is local (no
        # API call) and must never spend the override either.
        if argv == ["api", "user", "--jq", ".login"] or argv == ["auth", "token"]:
            os.execv(real_gh, [real_gh, *argv])
            return  # pragma: no cover -- see the execv note below

        # The override, when fresh, is spent here -- the single place this
        # process ever actually execs the real `gh` -- and bypasses BOTH
        # checks below (scan shape and budget floor). It is not scoped to
        # "unlock one scan": the operator's `touch` means "let the next
        # call through, whatever it is" (harmonic-forge#650 preclose-check
        # finding: an override that only bypassed the scan check was still
        # spent and lost when the budget floor then refused the same call).
        if gh_scan_patterns.consume_override():
            os.execv(real_gh, [real_gh, *argv])
            return  # pragma: no cover -- execv never returns for real; the
            # return exists so tests that mock it out see the intended
            # control flow (fall through to the final execv is a bug, not
            # a fallback -- it would exec `gh` a second time).

        # harmonic-forge#964: a sanctioned caller is identified by the marker it
        # sets, never by its argv. It skips only the scan refusal; the budget
        # floor below still applies. A convention, not a boundary: the
        # PreToolUse hook still refuses a scan typed directly.
        sanctioned = os.environ.get("GH_SHIM_CALLER", "") in SANCTIONED_CALLERS
        reason = None if sanctioned else gh_scan_patterns.scan_reason(argv)
        if reason is not None:
            print(
                f"gh-shim: refused ({reason}). Read named issues only; for a "
                "real full scan the operator runs: "
                "touch ~/.cache/harmonic-forge/gh_scan_override",
                file=sys.stderr,
            )
            sys.exit(3)

        is_internal_budget_probe = (
            len(argv) >= 2 and argv[0] == "api" and argv[1] == "repos/vitalharmony/harmonic-forge"
            and "-i" in argv
        )
        is_auth_or_version = bool(argv) and (argv[0] == "auth" or argv[0] == "--version")

        if not is_auth_or_version and not is_internal_budget_probe:
            result = gh_scan_patterns.budget()
            if result is not None:
                remaining, reset_epoch = result
                if remaining < 1000:
                    reset_str = datetime.fromtimestamp(reset_epoch, tz=timezone.utc).strftime("%H:%M")
                    print(
                        f"gh-shim: refused, REST core budget low: {remaining} remaining, "
                        f"resets {reset_str} UTC",
                        file=sys.stderr,
                    )
                    sys.exit(3)
                # result is None: fail open, budget genuinely unknowable.
    except SystemExit:
        raise
    except Exception as exc:  # pragma: no cover - fail-open is the point
        print(f"gh-shim: internal error ({exc!r}), passing through to real gh", file=sys.stderr)

    os.execv(real_gh, [real_gh, *argv])


if __name__ == "__main__":
    main()
