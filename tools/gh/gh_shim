#!/usr/bin/env python3
"""`~/.local/bin/gh` shim (harmonic-forge#650) -- the second of two
independent REST-budget-exhaustion guards.

WHY A SHIM AND NOT ONLY A HOOK
---------------------------------
`tools/hooks/guard_gh_rest_budget.py` catches a scan-shaped `gh` command
typed directly into a Bash tool call. It cannot see a `gh` invocation made
from *inside* a running script via `subprocess` -- by the time that runs,
there is no shell command for a `PreToolUse` hook to inspect. Installed via
`tools/gh/install_gh_shim.sh` at `~/.local/bin/gh` (ahead of the real `gh`
on PATH), this script IS `gh` for every caller, script or interactive alike,
so it sees every invocation regardless of how it was launched.

FAIL OPEN, except a close or merge: fail closed (harmonic-forge#1447), ALWAYS
---------------------
A bug in this shim must never brick `gh` entirely -- see the broad
try/except around all pattern-module usage below. Anything unexpected
degrades to "run the real gh", never to a hang or a crash.
"""

from __future__ import annotations

import os
import re
import sys
from datetime import datetime, timezone


def _self_realpath() -> str:
    return os.path.realpath(os.path.abspath(__file__))


def _resolve_real_gh() -> str:
    self_real = _self_realpath()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "gh")
        if not os.path.isfile(candidate):
            continue
        try:
            real = os.path.realpath(candidate)
        except OSError:
            continue
        if real != self_real:
            return candidate
    return "/usr/bin/gh"


#: harmonic-forge#964: callers whose scans are sanctioned, by the
#: `GH_SHIM_CALLER` marker they set. `item_list_cache` throttles its own
#: board reads; `batch_preflight` finds an issue's PR by branch prefix;
#: `l1_post` reads one branch's open PR (`pulls?head=`). harmonic-forge#1032:
#: `gh_issue` runs one title search (`search/issues`) before each filing (R-0397).
#: harmonic-forge#1356: `ui_grant` lists open PRs once to find the PR a merge grant names.
SANCTIONED_CALLERS = frozenset({"item_list_cache", "batch_preflight", "l1_post", "gh_issue", "ui_grant"})

#: harmonic-forge#1363: the only argv `bounded_scan` may scan with:
#: `api [-i] [-H "If-None-Match: <etag>"] repos/<owner>/<repo>/(issues|pulls)?<query>`.
_BOUNDED_SCAN_PATH = re.compile(r"^repos/([^/\s]+)/([^/\s]+)/(issues|pulls)\?[^\s]*$")


def _bounded_scan_refusal(argv: list[str]) -> str | None:
    """None when `argv` is bounded_scan.py's own GET shape under a live SCAN grant
    for the path's repo and scope in this session (CLAUDE_CODE_SESSION_ID, which
    bounded_scan passes through); otherwise the check that refused, named.

    Fails closed: an argv of another shape, a missing session, an import or grant
    store that cannot be read, or no live grant is never admitted. Since
    harmonic-forge#1378 the refusal is named, because a silent `False` hid that
    every live scan was refused (the import below used to resolve through the
    `~/.local/bin/gh` symlink and could never find `scan_grant`)."""
    rest = list(argv)
    if rest[:1] != ["api"]:
        return "not an `api` call"
    rest = rest[1:]
    if rest[:1] == ["-i"]:
        rest = rest[1:]
    if rest[:1] == ["-H"] and len(rest) >= 2 and rest[1].lower().startswith("if-none-match:"):
        rest = rest[2:]
    if len(rest) != 1:
        return "argv is not bounded_scan's `api [-i] [-H If-None-Match] <path>` shape"
    match = _BOUNDED_SCAN_PATH.match(rest[0])
    if match is None:
        return "path is not a repos/<owner>/<repo>/(issues|pulls)?<query> list path"
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not session:
        return "no CLAUDE_CODE_SESSION_ID"
    page = re.search(r"[?&]page=([1-9]\d{0,4})(?:&|$)", rest[0])
    if page is None:
        return "path has no page=<n>"
    try:
        # harmonic-forge#1378: the REAL directory of this file. `gh` is the
        # symlink ~/.local/bin/gh, and abspath(__file__) keeps the link, so
        # `../hooks` resolved to ~/.local/hooks and `scan_grant` never imported.
        here = os.path.dirname(_self_realpath())
        sys.path.insert(0, os.path.join(here, "..", "hooks"))
        sys.path.insert(0, here)
        import scan_grant  # noqa: PLC0415
        import bounded_scan  # noqa: PLC0415
    except Exception as exc:  # noqa: BLE001 - refused, and named
        return f"admission could not import its checks ({type(exc).__name__}: {exc})"
    repo = f"{match.group(1)}/{match.group(2)}"
    try:
        scopes = scan_grant.live_scopes(repo, session)
        # Preclose pass 1 (#1363), survivor 1: the path must be exactly the one
        # bounded_scan.list_path builds for a live granted scope, page aside, so a
        # grant for one scope never admits another list of the same repo.
        if any(rest[0] == bounded_scan.list_path(repo, scope, int(page.group(1)))
               for scope in scopes):
            return None
    except Exception as exc:  # noqa: BLE001 - an unreadable grant admits nothing
        return f"grant check failed ({type(exc).__name__}: {exc})"
    # live_scopes swallows its own store errors, so an unreadable grant store
    # also lands here (#1378 pitch-inspection change 2).
    return f"no live SCAN grant for {repo} in this session covers this path"


def _bounded_scan_admitted(argv: list[str]) -> bool:
    """harmonic-forge#1363's predicate, kept for its callers and tests."""
    return _bounded_scan_refusal(argv) is None


# BEGIN generated by tools/hooks/gen_gh_flag_table.py -- do not edit by hand (gh 2.103.3)
_GH_BUILTINS = frozenset({"--help", "--version", "-h", "__complete", "__completeNoDesc", "agent-task", "alias", "api", "attestation", "auth", "browse", "cache", "codespace", "completion", "config", "copilot", "discussion", "extension", "gist", "gpg-key", "help", "issue", "label", "licenses", "org", "pr", "preview", "project", "release", "repo", "ruleset", "run", "search", "secret", "skill", "ssh-key", "status", "variable", "version", "workflow"})
# END generated

#: harmonic-forge#1447 reforge: only these roots can close or merge. Every
#: other builtin passes without importing the gate; a non-builtin may be an
#: alias or an extension, so it goes to the gate too.
_GATED_ROOTS = frozenset({"api", "issue", "pr"})
#: The identity calls every lane entrypoint makes first (harmonic-forge#804).
#: They pass even when the gate cannot be imported.
_IDENTITY_ARGV = (["api", "user", "--jq", ".login"], ["auth", "token"])


def _needs_gate(argv: list[str]) -> bool:
    """False only for a builtin root that is not `api`, `issue` or `pr`."""
    if not argv:
        return False
    return argv[0] in _GATED_ROOTS or argv[0] not in _GH_BUILTINS


def _close_merge_gate(argv: list[str], real_gh: str) -> None:
    """Refuse (exit 4) a close or merge the gates deny, or any gated call the
    gate cannot classify or evaluate; return for every other call
    (harmonic-forge#1447). Deny by default: `gh_argv` lists the calls that
    cannot close or merge, and an argv it cannot parse is refused."""
    if not _needs_gate(argv):
        return
    try:
        here = os.path.dirname(_self_realpath())
        hooks = os.path.join(here, "..", "hooks")
        if hooks not in sys.path:
            sys.path.insert(0, hooks)
        import close_gate  # noqa: PLC0415
    except Exception as exc:  # noqa: BLE001 - fail closed past the identity exemptions
        if argv in _IDENTITY_ARGV:
            return
        print(f"gh-shim: refused (close/merge gate internal error: {type(exc).__name__}: {exc}); "
              "nothing was sent (harmonic-forge#1447).", file=sys.stderr)
        sys.exit(4)
    try:
        verdict = close_gate.shim_verdict(argv, cwd=os.getcwd(), real_gh=real_gh)
    except Exception as exc:  # noqa: BLE001 - fail closed
        print(f"gh-shim: refused (close/merge gate internal error: {type(exc).__name__}: {exc}); "
              "nothing was sent (harmonic-forge#1447).", file=sys.stderr)
        sys.exit(4)
    if verdict:
        print(verdict, file=sys.stderr)
        sys.exit(4)


def main() -> None:
    argv = sys.argv[1:]
    real_gh = _resolve_real_gh()

    # harmonic-forge#1447: the close and merge gates, on the real argv, ahead of
    # every exemption and the override. FAIL CLOSED for a close or merge: any
    # error refuses and nothing is sent (exit 4, distinct from the scan and
    # budget refusals' 3). Everything else falls through untouched.
    _close_merge_gate(argv, real_gh)

    try:
        # harmonic-forge#1378: the real directory, not the ~/.local/bin symlink's.
        sys.path.insert(0, os.path.dirname(_self_realpath()))
        import gh_scan_patterns  # noqa: PLC0415 -- imported lazily so an import
        # failure alone can never prevent falling through to the real `gh`.

        # harmonic-forge#804: the per-project identity assertion (`gh api user --jq
        # .login`) is the first `gh` call of every lane entrypoint. It is exempt from
        # EVERYTHING below and short-circuits BEFORE the override is consumed:
        # consuming it here would spend the operator's one-shot grant on a call that
        # needed none, leaving the scan it was `touch`ed for still refused (preclose
        # finding), and a low REST budget must not block every post at its first line.
        # harmonic-forge#957 AC6: gh-as's token-fingerprint read is local (no
        # API call) and must never spend the override either.
        if argv == ["api", "user", "--jq", ".login"] or argv == ["auth", "token"]:
            os.execv(real_gh, [real_gh, *argv])
            return  # pragma: no cover -- see the execv note below

        # The override, when fresh, is spent here -- the single place this
        # process ever actually execs the real `gh` -- and bypasses BOTH
        # checks below (scan shape and budget floor). It is not scoped to
        # "unlock one scan": the operator's `touch` means "let the next
        # call through, whatever it is" (harmonic-forge#650 preclose-check
        # finding: an override that only bypassed the scan check was still
        # spent and lost when the budget floor then refused the same call).
        if gh_scan_patterns.consume_override():
            os.execv(real_gh, [real_gh, *argv])
            return  # pragma: no cover -- execv never returns for real; the
            # return exists so tests that mock it out see the intended
            # control flow (fall through to the final execv is a bug, not
            # a fallback -- it would exec `gh` a second time).

        # harmonic-forge#964: a sanctioned caller is identified by the marker it
        # sets, never by its argv. It skips only the scan refusal; the budget
        # floor below still applies. A convention, not a boundary: the
        # PreToolUse hook still refuses a scan typed directly.
        caller = os.environ.get("GH_SHIM_CALLER", "")
        sanctioned = caller in SANCTIONED_CALLERS
        if caller == "bounded_scan":
            # harmonic-forge#1363: the marker alone is not enough for this caller. It
            # admits only the one shape bounded_scan.py sends, and only under a live
            # SCAN grant for that repo in this session.
            refusal = _bounded_scan_refusal(argv)
            sanctioned = refusal is None
            if refusal is not None:
                print(f"gh-shim: bounded_scan not admitted: {refusal}", file=sys.stderr)
        reason = None if sanctioned else gh_scan_patterns.scan_reason(argv)
        if reason is not None:
            print(
                f"gh-shim: refused ({reason}). Read named issues only; for a "
                "bounded scan the operator types, as the prompt's first line, "
                "`SCAN <letter> <scope>: <reason>` and the session runs "
                "tools/gh/bounded_scan.py. Emergency fallback only: "
                "touch ~/.cache/harmonic-forge/gh_scan_override",
                file=sys.stderr,
            )
            sys.exit(3)

        is_internal_budget_probe = (
            len(argv) >= 2 and argv[0] == "api" and argv[1] == "repos/vitalharmony/harmonic-forge"
            and "-i" in argv
        )
        is_auth_or_version = bool(argv) and (argv[0] == "auth" or argv[0] == "--version")

        if not is_auth_or_version and not is_internal_budget_probe:
            result = gh_scan_patterns.budget()
            if result is not None:
                remaining, reset_epoch = result
                if remaining < 1000:
                    reset_str = datetime.fromtimestamp(reset_epoch, tz=timezone.utc).strftime("%H:%M")
                    print(
                        f"gh-shim: refused, REST core budget low: {remaining} remaining, "
                        f"resets {reset_str} UTC",
                        file=sys.stderr,
                    )
                    sys.exit(3)
                # result is None: fail open, budget genuinely unknowable.
    except SystemExit:
        raise
    except Exception as exc:  # pragma: no cover - fail-open is the point
        print(f"gh-shim: internal error ({exc!r}), passing through to real gh", file=sys.stderr)

    os.execv(real_gh, [real_gh, *argv])


if __name__ == "__main__":
    main()
