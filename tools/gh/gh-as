#!/usr/bin/env bash
# gh-as — run a command with `gh` scoped to a specific GitHub account,
# without touching global auth state.
#
# Each account gets its own gh config directory, so concurrent sessions
# working on different repos never interfere with each other. There is no
# switch to undo: the scoping lives and dies with the process.
#
#   gh-as <account> <command...>
#
#   gh-as harmonicarchitect gh issue list -R harmonicarchitect/kenekted-platform
#   gh-as harmonicarchitect python3 some_script.py
#   gh-as vitalharmony gh pr list -R vitalharmony/harmonic-forge
#
# One-time setup per account:
#   gh-as --init <account>
#
# Accounts live in $GH_ACCT_HOME (default ~/.config/gh-accounts/<account>).

set -euo pipefail

ACCT_HOME="${GH_ACCT_HOME:-$HOME/.config/gh-accounts}"

# harmonic-forge#804: `gh` gives GH_TOKEN precedence over GH_CONFIG_DIR (tested
# 2026-09-28: GH_TOKEN=vitalharmony + the harmonicarchitect slot resolves to
# vitalharmony), so an inherited token would silently defeat the slot -- both the
# identity probe below and the exec. Cleared once, before either.
unset GH_TOKEN GITHUB_TOKEN

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

[ $# -ge 1 ] || usage 1

case "$1" in
  -h|--help) usage 0 ;;
  --list)
    if [ -d "$ACCT_HOME" ]; then
      for d in "$ACCT_HOME"/*/; do
        [ -d "$d" ] || continue
        acct="$(basename "$d")"
        who="$(GH_CONFIG_DIR="$d" gh api user --jq .login 2>/dev/null || echo '(not authenticated)')"
        printf '%-24s %s\n' "$acct" "$who"
      done
    else
      echo "no accounts configured under $ACCT_HOME" >&2
    fi
    exit 0
    ;;
  --init)
    acct="${2:?usage: gh-as --init <account>}"
    dir="$ACCT_HOME/$acct"
    mkdir -p "$dir"
    chmod 700 "$ACCT_HOME" "$dir"
    echo "Authenticating '$acct' into $dir"
    echo "Choose the '$acct' account when prompted."
    GH_CONFIG_DIR="$dir" gh auth login --hostname github.com --git-protocol https --web
    actual="$(GH_CONFIG_DIR="$dir" gh api user --jq .login)"
    if [ "$actual" != "$acct" ]; then
      echo "WARNING: authenticated as '$actual', but this slot is named '$acct'." >&2
      echo "Re-run --init and pick the right account, or use '$actual' as the name." >&2
      exit 1
    fi
    echo "OK: '$acct' ready. Use: gh-as $acct <command...>"
    exit 0
    ;;
esac

acct="$1"; shift
[ $# -ge 1 ] || usage 1

dir="$ACCT_HOME/$acct"
if [ ! -d "$dir" ]; then
  echo "gh-as: no config for account '$acct'." >&2
  echo "Set it up once with:  gh-as --init $acct" >&2
  exit 1
fi

# harmonic-forge#957: a probe that succeeded under the slot's CURRENT token is
# remembered for GH_AS_IDENTITY_TTL seconds (default 900; 0 disables), keyed by
# a SHA-256 fingerprint of that token. A token replaced out of band has a new
# fingerprint, so it is always re-probed (R-0015). Only the fingerprint is
# stored; a failed or mismatched probe is never remembered.
ttl="${GH_AS_IDENTITY_TTL:-900}"
case "$ttl" in ''|*[!0-9]*) ttl=900 ;; esac
memo="$dir/.identity-memo"
fp=""
if [ "$ttl" -gt 0 ]; then
  fp="$(GH_CONFIG_DIR="$dir" gh auth token 2>/dev/null | sha256sum 2>/dev/null | cut -d' ' -f1 || true)"
  # An empty token hashes to this; treat it as unreadable (AC3).
  [ "$fp" = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ] && fp=""
fi
if [ -n "$fp" ] && [ -f "$memo" ]; then
  read -r m_fp m_acct m_time < "$memo" 2>/dev/null || true
  now="$(date +%s)"
  # A non-numeric time is a malformed memo: a miss that re-probes, never an
  # arithmetic error (preclose pass 1).
  case "${m_time:-}" in ''|*[!0-9]*) m_time="" ;; esac
  if [ "${m_fp:-}" = "$fp" ] && [ "${m_acct:-}" = "$acct" ] \
     && [ -n "$m_time" ] && [ $((now - m_time)) -lt "$ttl" ] && [ $((now - m_time)) -ge 0 ]; then
    export GH_CONFIG_DIR="$dir"
    exec "$@"
  fi
fi

# Verify the slot still holds the account it claims, so a command can never
# run against the wrong identity because a token was replaced out of band.
# A probe that exits nonzero is a failed probe, whatever it printed (preclose
# cross-family check).
if ! actual="$(GH_CONFIG_DIR="$dir" gh api user --jq .login 2>/dev/null)"; then
  actual=""
fi
if [ -z "$actual" ]; then
  echo "gh-as: account '$acct' is not authenticated (token expired or revoked)." >&2
  echo "Re-run:  gh-as --init $acct" >&2
  exit 1
fi
if [ "$actual" != "$acct" ]; then
  echo "gh-as: slot '$acct' is authenticated as '$actual' — refusing to run." >&2
  exit 1
fi

# Remember only if the token is still the one fingerprinted before the probe,
# so one token's hash can never be tied to another token's login (pass 1).
if [ -n "$fp" ]; then
  fp_after="$(GH_CONFIG_DIR="$dir" gh auth token 2>/dev/null | sha256sum 2>/dev/null | cut -d' ' -f1 || true)"
  if [ "$fp_after" != "$fp" ]; then
    # The token changed during verification, so the command would run under a
    # token nobody probed: refuse (fails closed; preclose cross-family check).
    echo "gh-as: slot '$acct' changed its token during verification -- refusing; retry." >&2
    exit 1
  fi
fi
if [ -n "$fp" ]; then
  tmp="$(umask 077; mktemp "$dir/.identity-memo.XXXXXX")" \
    && printf '%s %s %s\n' "$fp" "$acct" "$(date +%s)" > "$tmp" \
    && chmod 600 "$tmp" && mv -f "$tmp" "$memo" || rm -f "${tmp:-}"
fi

export GH_CONFIG_DIR="$dir"
exec "$@"
