[Unit]
Description=Harmonic Forge te-runner: work the named Tooling Exception queue serially (harmonic-forge#1055)
OnFailure=forge-te-runner-alert.service

[Service]
Type=oneshot
# The unit owns its PATH: `claude` lives in ~/.local/bin (harmonic-forge#1107), and
# the lanes' codex in ~/.npm-global/bin, ahead of /usr/local/bin's (harmonic-forge#1112).
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin
# The budget has no default: runner.env must set TE_RUNNER_BUDGET_USD, or te_run.py refuses.
EnvironmentFile=%h/.config/te-runner/runner.env
ExecStart=/usr/bin/python3 %h/harmonic-forge/tools/runner/te_run.py run --queue %h/.local/share/te-runner/queue.json --max-budget-usd ${TE_RUNNER_BUDGET_USD}
# Whatever the run's outcome, render its report and send the one-line
# notification (harmonic-forge#1112 AC13); the alert unit stays for failures.
ExecStopPost=/bin/sh -c 'report=$$(/usr/bin/python3 %h/harmonic-forge/tools/runner/report.py render --queue %h/.local/share/te-runner/queue.json --out %h/.local/share/te-runner/reports) && /usr/bin/python3 %h/harmonic-forge/tools/runner/report.py notify --report "$$report"'
StandardOutput=append:%h/Harmonic_Projects/logs/forge-te-runner.log
StandardError=append:%h/Harmonic_Projects/logs/forge-te-runner.log
