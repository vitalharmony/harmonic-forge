#!/usr/bin/env bash
# Launch a Lane 2 (implementer) session (harmonic-forge#142).
# Automatically switches to the current project's dedicated Lane 2
# worktree (the sibling directory <project>-lane2) before launching --
# so `lane2` from the main checkout or another lane worktree lands in
# the right place. Proper hygiene is restarting with the right script,
# never changing lanes mid-session.
# Sets LANE=2 and LANE_AGENT, and inhibits system sleep/idle for the
# session's lifetime.
#
# Scope note: the LANE env-var signal, and the HRSE2 hook that reads it
# (scripts/block_lane1_status_claims.py), only cover Claude-Code-based
# Lane 2 sessions. A Codex Lane 2 session is unaffected -- Codex's own
# hook mechanism (.codex/hooks.json) is a separate concern.
#
# Which agent runs is chosen with `--agent claude|codex|gemini` against the
# closed registry in tools/lane/_agent_registry.sh; native CLI arguments follow,
# optionally after a bare `--`. LANE_CLI is retained for aliases such as
# claude-api, and the two are mutually exclusive (ADR-007 § 3). The launch
# command itself is built by the shared tools/lane/_cli_launch.sh.
# See those files and 3-lane-protocol.md's "Per-CLI launch wiring".
set -euo pipefail

_lane_name="lane2"

if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "lane2: not inside a git repository -- cd into a project first" >&2
  exit 1
fi
parent="$(dirname "$root")"
base="$(basename "$root")"
if [[ "$base" =~ ^(.+)-lane[0-9]+$ ]]; then
  base="${BASH_REMATCH[1]}"
fi
target="$parent/$base-lane2"

if [ ! -d "$target" ]; then
  echo "lane2: expected worktree '$target' does not exist -- create it first (see 3-lane-protocol.md's Per-Lane Working Directories), not falling back to the main checkout" >&2
  exit 1
fi

cd "$target"
# shellcheck source=_lane_args.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_args.sh" "$@"
# shellcheck source=_gh_config_dir.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_gh_config_dir.sh"
export LANE=2

# shellcheck source=_cli_launch.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_cli_launch.sh"

# harmonic-forge#264: see tools/lane/lane3-provision for the full incident
# (hrse#792) -- backend/.env has no legitimate per-worktree divergence, so a
# symlink to the main checkout's real file makes drift structurally impossible
# instead of merely detected. Never reads or prints the file's contents.
# Silently skipped for a project with no backend/.env (harmonic-forge itself,
# or any non-HRSE2-shaped project).
#
# Lane 2 still repairs this in place, deliberately. harmonic-forge#322 AC5
# removes the equivalent mutation from lane3 ONLY, and for a reason specific to
# lane3: a gate that repairs its own preconditions cannot report on them. Lane 2
# is not a gate and reports on nothing, so silently guaranteeing a correct
# backend/.env before an implementer starts is exactly the right behavior here.
main_root="$parent/$base"
if [ -f "$main_root/backend/.env" ]; then
  main_env_real="$(readlink -f "$main_root/backend/.env")"
  target_env_real="$(readlink -f "$target/backend/.env" 2>/dev/null || true)"
  if [[ ! -L "$target/backend/.env" || "$target_env_real" != "$main_env_real" ]]; then
    ln -sf "$main_env_real" "$target/backend/.env"
    echo "lane2: relinked backend/.env -> $main_env_real (was drifting or missing)" >&2
  fi
fi

exec systemd-inhibit \
  --what=sleep:idle \
  --who="lane2" \
  --why="Lane 2 (implementer) $lane_agent_display session" \
  --mode=block \
  "${cli_args[@]}"
