#!/usr/bin/env python3
"""Drive an exec-originated Codex lane through a durable queue (F774)."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
import tomllib
from contextlib import contextmanager
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
import queue_state

PROMPT = ("Read the queue state file and work every pending item in order. Before "
          "each item set it in_progress; after it set it done. If blocked, set its "
          "status to blocked with the reason. Report only when empty or blocked.")


def log_path(lane: str, root: Path) -> Path:
    directory = root / ".cache" / "lane-queue-run"
    directory.mkdir(parents=True, exist_ok=True)
    return directory / f"{lane}-{int(time.time() * 1000)}.log"


def _session_ids(session: str, home: Path) -> set[str]:
    ids = {session}
    index = home / ".codex" / "session_index.jsonl"
    try:
        for line in index.read_text(encoding="utf-8").splitlines():
            entry = json.loads(line)
            if entry.get("thread_name") == session and isinstance(entry.get("id"), str):
                ids.add(entry["id"])
    except (OSError, ValueError):
        pass
    return ids


def session_cwd(session: str, home: Path) -> str | None:
    """Read cwd from rollout session_meta, never from the insufficient index."""
    ids = _session_ids(session, home)
    sessions = home / ".codex" / "sessions"
    if not sessions.is_dir():
        return None
    for path in sessions.rglob("rollout-*.jsonl"):
        if not any(path.name.endswith(f"-{ident}.jsonl") for ident in ids):
            continue
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            meta = entry.get("session_meta", entry)
            if isinstance(meta, dict) and isinstance(meta.get("cwd"), str):
                return str(Path(meta["cwd"]).resolve())
    return None


def trusted(repo: Path, home: Path) -> bool:
    """Codex hook trust is persisted per project in config.toml."""
    hooks = repo / ".codex" / "hooks.json"
    config = home / ".codex" / "config.toml"
    try:
        data = tomllib.loads(config.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    project = data.get("projects", {}).get(str(repo.resolve()), {})
    return hooks.is_file() and isinstance(project, dict) and project.get("trust_level") == "trusted"


def resume_args(lane: str, *, execute=subprocess.run) -> list[str]:
    helper = Path(__file__).with_name("queue_resume_args.sh")
    result = execute([str(helper), lane], capture_output=True)
    if result.returncode:
        raise ValueError("cannot resolve lane resume flags")
    return [token.decode() for token in result.stdout.split(b"\0") if token]


def lane_repo(lane: str, repo: Path) -> Path:
    """Refuse a caller-selected sibling: the named launcher owns this cwd."""
    repo = repo.resolve()
    match = re.fullmatch(r"(.+)-lane([23])", repo.name)
    if lane == "1":
        if match:
            raise ValueError("lane 1 must use the main checkout")
    elif not match or match.group(2) != lane:
        raise ValueError(f"lane {lane} must use its -lane{lane} worktree")
    return repo


@contextmanager
def session_lock(session: str, home: Path):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", session)
    path = home / ".cache" / "lane-queue-run" / "locks" / f"{safe}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ValueError("session is already running") from exc
        yield


def _log(log: Path, text: str) -> None:
    with log.open("a", encoding="utf-8") as out:
        out.write(text + "\n")


def run(argv: list[str], *, execute=subprocess.run, home: Path | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--lane", choices=("1", "2", "3"), required=True)
    parser.add_argument("--session", required=True)
    parser.add_argument("--queue", type=Path, required=True)
    parser.add_argument("--max-steps", type=int, default=50)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    args = parser.parse_args(argv)
    if args.max_steps < 1:
        parser.error("--max-steps must be positive")
    home = home or Path.home()
    try:
        repo = lane_repo(args.lane, args.repo)
    except ValueError as exc:
        print(f"lane-queue-run: {exc}", file=sys.stderr)
        return 2
    if session_cwd(args.session, home) != str(repo):
        print("lane-queue-run: session cwd does not match named lane repo", file=sys.stderr)
        return 2
    if not trusted(repo, home):
        print("lane-queue-run: hook trust is not persisted for lane repo", file=sys.stderr)
        return 2
    try:
        state = queue_state.load(args.queue)
    except ValueError as exc:
        print(f"lane-queue-run: {exc}", file=sys.stderr)
        return 2
    log = log_path(args.lane, home)
    try:
        with session_lock(args.session, home):
            if queue_state.recover(state):
                queue_state.save(args.queue, state)
                _log(log, "stopped: recovery blocker before step 0")
                return 0
            for step in range(args.max_steps):
                if queue_state.is_blocked(state):
                    _log(log, f"stopped: blocker after {step} steps")
                    return 0
                item = queue_state.next_item(state)
                if item is None:
                    _log(log, f"stopped: queue empty after {step} steps")
                    return 0
                item["status"] = "in_progress"
                queue_state.save(args.queue, state)
                command = ["codex", "exec", *resume_args(args.lane), "resume", args.session,
                           f"{PROMPT} Queue: {args.queue}. Current item: {item['id']}"]
                env = os.environ | {"LANE": args.lane, "LANE_AGENT": "codex",
                                    "TMPDIR": str(home / ".cache" / "codex-lane-tmp" / f"lane{args.lane}"),
                                    "GIT_CEILING_DIRECTORIES": str(repo.parent)}
                result = execute(command, cwd=repo, env=env, text=True)
                _log(log, f"step {step + 1}: {item['id']} exit={result.returncode}")
                if result.returncode:
                    item["status"] = "blocked"
                    item["note"] = f"resume exited {result.returncode}"
                    queue_state.save(args.queue, state)
                    _log(log, f"stopped: resume exit {result.returncode}")
                    return result.returncode
                state = queue_state.load(args.queue)
                current = next(candidate for candidate in state["items"] if candidate["id"] == item["id"])
                if current["status"] == "in_progress":
                    current["status"] = "blocked"
                    current["note"] = "resume returned without recording a terminal item status"
                    queue_state.save(args.queue, state)
                    _log(log, f"stopped: missing terminal status after {step + 1} steps")
                    return 0
            _log(log, f"stopped: max steps {args.max_steps}")
            return 0
    except KeyboardInterrupt:
        _log(log, "stopped: interrupted")
        return 130
    except ValueError as exc:
        print(f"lane-queue-run: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:]))
