#!/usr/bin/env bash
# Launch a Claude Code session as Lane 3 (gate) (harmonic-forge#142).
# Automatically switches to the current project's dedicated Lane 3
# worktree (the sibling directory <project>-lane3) before launching --
# so `lane3` from the main checkout or another lane worktree lands in
# the right place. Proper hygiene is restarting with the right script,
# never changing lanes mid-session.
# Sets LANE=3 and inhibits system sleep/idle for the session's lifetime.
# Defaults to --permission-mode auto (override with LANE_PERMISSION_MODE,
# e.g. LANE_PERMISSION_MODE=manual lane3). If --permission-mode is
# already present in "$@", the default is skipped entirely rather than
# passed twice -- avoids depending on whether Claude Code's CLI parser
# treats a repeated flag as last-wins or an error.
set -euo pipefail

if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "lane3: not inside a git repository -- cd into a project first" >&2
  exit 1
fi
parent="$(dirname "$root")"
base="$(basename "$root")"
if [[ "$base" =~ ^(.+)-lane[0-9]+$ ]]; then
  base="${BASH_REMATCH[1]}"
fi
target="$parent/$base-lane3"

if [ ! -d "$target" ]; then
  echo "lane3: expected worktree '$target' does not exist -- create it first (see 3-lane-protocol.md's Per-Lane Working Directories), not falling back to the main checkout" >&2
  exit 1
fi

cd "$target"
export LANE=3

# harmonic-forge#255: this worktree can sit detached at an old commit
# indefinitely -- nothing previously checked, so a session silently read
# stale skill/protocol files (.devin/, harmonic-forge rules) straight out
# of this worktree with no signal anything was wrong. Real incident: this
# worktree was detached 2+ days behind origin/main, still carrying the
# pre-fix "read the full issue thread" instruction harmonic-forge#253 had
# already replaced on main, causing an avoidable Lane 3 spec-derivation
# contamination the fix was specifically meant to prevent.
# Warning only, never a block -- a Lane 3 session legitimately gating a
# specific older target branch is not behind by mistake, and this script
# has no way to distinguish that from genuine staleness.
if git fetch origin main -q 2>/dev/null; then
  current_head="$(git rev-parse HEAD 2>/dev/null || true)"
  main_head="$(git rev-parse origin/main 2>/dev/null || true)"
  if [ -n "$current_head" ] && [ -n "$main_head" ] && [ "$current_head" != "$main_head" ] \
     && ! git merge-base --is-ancestor "$main_head" "$current_head" 2>/dev/null; then
    behind="$(git rev-list --count "$current_head".."$main_head" 2>/dev/null || echo '?')"
    echo "lane3: WARNING -- this worktree is $behind commit(s) behind origin/main. Skill/protocol files (.devin/, harmonic-forge rules) read from this worktree may be stale. If you are not intentionally gating an older target branch, run: git fetch origin main && git checkout origin/main" >&2
  fi
fi

cli_args=("${LANE_CLI:-claude}")
has_permission_mode=0
for arg in "$@"; do
  if [[ "$arg" == "--permission-mode" || "$arg" == --permission-mode=* ]]; then
    has_permission_mode=1
    break
  fi
done
if [ "$has_permission_mode" -eq 0 ] && [[ "${LANE_CLI:-claude}" == claude* ]]; then
  cli_args+=(--permission-mode "${LANE_PERMISSION_MODE:-auto}")
fi
cli_args+=("$@")

exec systemd-inhibit \
  --what=sleep:idle \
  --who="lane3" \
  --why="Lane 3 (gate) Claude Code session" \
  --mode=block \
  "${cli_args[@]}"
