#!/usr/bin/env bash
# Launch a Lane 3 (gate) session (harmonic-forge#142).
# Automatically switches to the current project's dedicated Lane 3
# worktree (the sibling directory <project>-lane3) before launching --
# so `lane3` from the main checkout or another lane worktree lands in
# the right place. Proper hygiene is restarting with the right script,
# never changing lanes mid-session.
# Sets LANE=3 and LANE_AGENT, and inhibits system sleep/idle for the
# session's lifetime.
#
# Which agent runs is chosen with `--agent claude|codex|gemini` against the
# closed registry in tools/lane/_agent_registry.sh; native CLI arguments follow,
# optionally after a bare `--`. LANE_CLI is retained for aliases such as
# claude-api, and the two are mutually exclusive (ADR-007 § 3). The launch
# command itself is built by the shared tools/lane/_cli_launch.sh.
# See those files and 3-lane-protocol.md's "Per-CLI launch wiring".
#
## THIS LAUNCHER REPAIRS ITS PRECONDITIONS AND RECORDS THEM (harmonic-forge#761)
#
# It brings the worktree to origin/main and relinks backend/.env at launch,
# replacing harmonic-forge#322 AC5's refuse-only design by operator ruling
# (2026-09-26). The repair is always recorded -- see the block after
# `export LANE=3` -- so the gate can still report on its preconditions.
# `tools/lane/lane3-provision` remains the manual form of the same repairs.
set -euo pipefail

_lane_name="lane3"
_lane_allow_ack_stale=1

if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "lane3: not inside a git repository -- cd into a project first" >&2
  exit 1
fi
parent="$(dirname "$root")"
base="$(basename "$root")"
if [[ "$base" =~ ^(.+)-lane[0-9]+$ ]]; then
  base="${BASH_REMATCH[1]}"
fi
target="$parent/$base-lane3"

if [ ! -d "$target" ]; then
  echo "lane3: expected worktree '$target' does not exist -- create it first (see 3-lane-protocol.md's Per-Lane Working Directories), not falling back to the main checkout" >&2
  exit 1
fi

cd "$target"
# shellcheck source=_lane_args.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_args.sh" "$@"
# shellcheck source=_gh_config_dir.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_gh_config_dir.sh"
export LANE=3

## Checks 1 & 2 -- staleness and backend/.env sync (harmonic-forge#761)
#
# harmonic-forge#322 AC5's original design refused rather than repaired, on the
# theory that "a gate that repairs its own preconditions cannot report on
# them." The operator ruling of 2026-09-26 replaces that with the opposite
# design for the SAME reason, stated the other way round: a manual repair step
# that has to be remembered has already failed twice as a control (measured:
# HRSE2-lane3's sibling worktrees drifted 63 and 46 commits behind on
# 2026-09-21 and 09-26). So lane3 now repairs unconditionally -- both the
# checkout and backend/.env, exactly what `lane3-provision` did by hand -- and
# makes the repair REPORTED rather than forbidding it: every outcome is
# recorded in `LANE_REFRESH_STATUS`/`LANE_REFRESH_ENV`, exported into the
# session, logged to `~/.local/state/lanes/refresh.log`, and (for a Claude
# session) surfaced in the gate report by the SessionStart notice hook. A
# repaired precondition is now distinguishable from one that never needed
# repair -- it just isn't invisible any more.
#
# `--ack-stale "<reason>"` still exists, for a gate deliberately run against a
# target other than current origin/main (e.g. gating an older commit on
# purpose). It skips the checkout update only; backend/.env is still relinked
# (or, for a project declaring `lane3_env_task`, still provisioned -- from the
# main checkout's definition of that task, so an older target's tree need not
# carry it).
#
# The undetermined-remote-state refusal survives unchanged in spirit: an
# unreachable or ambiguous origin is drift, not its absence, and lane3 still
# refuses to start rather than guess. `lane_refresh`'s `fetch-failed` status is
# exactly that case.
#
# `lane3-provision` remains, unchanged, as the manual repair command --
# something to run without starting a session.
_lane3_stale_refuse() {
  lane_refresh_log_flush
  cat >&2 <<EOF
lane3: REFUSING TO START -- $1

  This worktree: $target
  $2

  To repair:   lane3-provision
  To proceed anyway (e.g. deliberately gating an older target branch):
               lane3 --ack-stale "<why this is intentional>"
EOF
  exit 1
}

# shellcheck source=_lane_refresh.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_refresh.sh"
# The refresh.log record carries the env status too (R-0187), which is only
# known after the backend/.env step below -- hold the record until then.
_lane_refresh_defer_log=1
lane_refresh detached
export LANE_REFRESH_STATUS LANE_REFRESH_FROM LANE_REFRESH_TO LANE_REFRESH_DETAIL

case "$LANE_REFRESH_STATUS" in
  fetch-failed)
    _lane3_stale_refuse \
      "cannot determine whether this worktree is stale" \
      "\`git ls-remote origin refs/heads/main\` or the subsequent fetch failed. The remote may be unreachable, origin may not have a main branch, or the fetched tip is missing from the object store. An undetermined staleness state is treated as drift, not as its absence."
    ;;
  checkout-failed)
    _lane3_stale_refuse \
      "the fetch succeeded but \`git checkout --detach\` failed" \
      "git said: $LANE_REFRESH_DETAIL"
    ;;
  skipped-dirty)
    _lane3_stale_refuse \
      "this worktree has tracked changes" \
      "Refusing to check out origin/main over them. Commit or move them first -- an untracked backend/.env alone never blocks this."
    ;;
  skipped-diverged)
    _lane3_stale_refuse \
      "$LANE_REFRESH_DETAIL" \
      "Refusing to detach this worktree away from unpushed work. Push it or move it off this worktree first."
    ;;
  skipped-busy)
    echo "lane3: WARNING -- another process is running in this worktree, so it was NOT updated and may be stale; the gate report must say so:" >&2
    printf '%s\n' "$LANE_REFRESH_DETAIL" | sed 's/^/  /' >&2
    ;;
  ack-stale)
    echo "lane3: staleness acknowledged by the operator -- \"$lane_ack_stale\"" >&2
    ;;
  updated)
    echo "lane3: worktree was behind and was updated at launch, $LANE_REFRESH_FROM -> $LANE_REFRESH_TO" >&2
    [ -n "$LANE_REFRESH_DETAIL" ] && echo "lane3: $LANE_REFRESH_DETAIL" >&2
    ;;
  *)
    echo "lane3: worktree is current at $LANE_REFRESH_TO" >&2
    ;;
esac

# backend/.env: operator ruling 2026-09-26 -- lane3 now relinks automatically,
# the same repair `lane3-provision` performs by hand (harmonic-forge#264).
# Never reads or prints the file's contents, only where it lives on disk, so
# this never touches secret values. Silently skipped for a project with no
# backend/.env at all (harmonic-forge itself, or any non-HRSE2-shaped
# project).
#
# harmonic-forge#875: the relink is now the "declared nothing" case of a
# three-way branch. A project declaring `lane3_env_task` in projects.toml has
# that task run here INSTEAD (hrse: its gate worktree owns a disposable-graph
# backend/.env, harmonic-forge#861, which the relink used to undo). A failed
# task, or ANY failure to look the declaration up, refuses the launch: reading
# a failed lookup as "declared nothing" would relink production credentials
# back in, the exact bug this branch exists to stop.
_lane3_env_refuse() {
  LANE_REFRESH_ENV="${4:-provision-failed}"
  export LANE_REFRESH_ENV
  lane_refresh_log_flush
  cat >&2 <<EOF
lane3: REFUSING TO START -- $1

  This worktree: $target
  $2

  To repair:   $3
EOF
  exit 1
}

main_root="$parent/$base"
LANE_REFRESH_ENV="n/a"
if [ -f "$main_root/backend/.env" ]; then
  if ! lane3_env_lookup "$main_root"; then
    _lane3_env_refuse \
      "cannot determine whether this project declares a Lane 3 env task" \
      "$LANE3_ENV_LOOKUP_ERROR" \
      "fix the launcher's own forge checkout's projects.toml so this checkout resolves, then relaunch lane3"
  elif [ -n "$LANE3_ENV_TASK" ]; then
    # Resolved and run from the main checkout, targeting this worktree -- see
    # lane3_env_run_task for why the gate worktree's own ref is not used.
    echo "lane3: running this project's declared Lane 3 env task 'mise run $LANE3_ENV_TASK -- --root $target' from $main_root instead of relinking backend/.env" >&2
    if lane3_env_run_task "$main_root" "$target" "$LANE3_ENV_TASK"; then
      LANE_REFRESH_ENV="provisioned"
    else
      case "$LANE3_ENV_OUTCOME" in
        undefined)   _lane3_env_why="the declared Lane 3 env task '$LANE3_ENV_TASK' is not defined in the main checkout" ;;
        list-failed) _lane3_env_why="mise could not list the main checkout's tasks to find '$LANE3_ENV_TASK'" ;;
        *)           _lane3_env_why="the declared Lane 3 env task 'mise run $LANE3_ENV_TASK' failed" ;;
      esac
      _lane3_env_refuse \
        "$_lane3_env_why" \
        "backend/.env was NOT relinked to the main checkout's -- this project's gate worktree owns its own." \
        "$(lane3_env_remedy "$main_root" "$target" "$LANE3_ENV_TASK" "relaunch lane3")"
    fi
  elif [ -e "$target/backend/.env" ] && [ ! -L "$target/backend/.env" ]; then
    # harmonic-forge#875 sticky-wicket: the relink only ever replaces an
    # absent target or a symlink. A real file here is the #861 shape -- a gate
    # worktree that owns its env -- so the manifest consulted is wrong, and
    # replacing it would put production credentials back. Never moved aside,
    # never replaced: evidence from the filesystem, not the manifest.
    _lane3_env_refuse \
      "backend/.env is a real file, not a symlink, but this project declares no Lane 3 env task" \
      "$target/backend/.env was left untouched -- a gate worktree that owns its env must declare lane3_env_task in projects.toml." \
      "declare this project's lane3_env_task in the launcher's own forge checkout's projects.toml, or remove $target/backend/.env yourself if it is genuinely a stale copy, then relaunch lane3" \
      "owned-unexpected"
  else
    main_env_real="$(readlink -f "$main_root/backend/.env")"
    target_env_real="$(readlink -f "$target/backend/.env" 2>/dev/null || true)"
    if [[ ! -L "$target/backend/.env" || "$target_env_real" != "$main_env_real" ]]; then
      mkdir -p "$target/backend"
      ln -sfn "$main_env_real" "$target/backend/.env"
      LANE_REFRESH_ENV="relinked"
      echo "lane3: relinked backend/.env -> $main_env_real (was drifting or missing)" >&2
    else
      LANE_REFRESH_ENV="ok"
    fi
  fi
fi
export LANE_REFRESH_ENV
lane_refresh_log_flush


# shellcheck source=_cli_launch.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_cli_launch.sh"

# H1414: Gemini's fresh Lane 3 path receives its filtered issue/diff context
# through the system-installed lane3-context extension. Do not merely launch a
# session that looks gated but lacks its only approved context capability.
if [ "$LANE_AGENT" = "gemini" ]; then
  extension_record="${HOME}/.gemini/extensions/lane3-context/.gemini-extension-install.json"
  extension_source="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../gemini/lane3-context"
  extension_registered="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("source", ""))' "$extension_record" 2>/dev/null || true)"
  extension_expected="$(readlink -f "$extension_source" 2>/dev/null || true)"
  extension_registered_real="$(readlink -f "$extension_registered" 2>/dev/null || true)"
  if [ ! -f "$extension_record" ] || [ -z "$extension_registered_real" ] || \
     [ ! -d "$extension_registered_real" ] || \
     [ ! -f "$extension_registered_real/gemini-extension.json" ] || \
     [ ! -f "$extension_registered_real/lane3_context_mcp.py" ] || \
     [ -z "$extension_expected" ] || [ ! -d "$extension_expected" ] || \
     [ "$extension_registered_real" != "$extension_expected" ]; then
    cat >&2 <<EOF
lane3: REFUSING TO START -- Gemini Lane 3 context extension is not installed from this platform checkout.

Install it once with:
  $(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../gemini/install-lane3-context-extension
EOF
    exit 1
  fi
fi

# shellcheck source=_lane_cleanup.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_cleanup.sh"

lane_run_with_cleanup systemd-inhibit \
  --what=sleep:idle \
  --who="lane3" \
  --why="Lane 3 (gate) $lane_agent_display session" \
  --mode=block \
  "${cli_args[@]}"
