#!/usr/bin/env bash
# Launch a Lane 1 session (harmonic-forge#142).
# Automatically switches to the current project's main checkout (the
# sibling of <project>-lane2/<project>-lane3 with no -laneN suffix)
# before launching -- so `lane1` from anywhere in a project's tree
# lands in the right place. Proper hygiene is restarting with the
# right script, never changing lanes mid-session.
# Sets LANE=1 and LANE_AGENT, and inhibits system sleep/idle for the
# session's lifetime.
#
# Which agent runs is chosen with `--agent claude|codex|gemini` against the
# closed registry in tools/lane/_agent_registry.sh; native CLI arguments follow,
# optionally after a bare `--`. LANE_CLI is retained for aliases such as
# claude-api, and the two are mutually exclusive (ADR-007 § 3). The launch
# command itself is built by the shared tools/lane/_cli_launch.sh.
# See those files and 3-lane-protocol.md's "Per-CLI launch wiring".
set -euo pipefail

_lane_name="lane1"

if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "lane1: not inside a git repository -- cd into a project first" >&2
  exit 1
fi
parent="$(dirname "$root")"
base="$(basename "$root")"
if [[ "$base" =~ ^(.+)-lane[0-9]+$ ]]; then
  base="${BASH_REMATCH[1]}"
fi
target="$parent/$base"

if [ ! -d "$target" ]; then
  echo "lane1: expected main checkout '$target' does not exist" >&2
  exit 1
fi

cd "$target"
# shellcheck source=_lane_args.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_args.sh" "$@"
# shellcheck source=_gh_config_dir.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_gh_config_dir.sh"
export LANE=1

# shellcheck source=_lane_refresh.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_refresh.sh"
lane_refresh branch
export LANE_REFRESH_STATUS LANE_REFRESH_FROM LANE_REFRESH_TO
# Operator ruling 2026-09-26: lane1 always reminds -- the dev backend (:8002)
# and frontend (:5173) run from this main checkout, and a fast-forward here
# can move code out from under them. Printed for every --agent (Codex/Gemini
# have no SessionStart hook, so this terminal line is their only carrier).
echo "lane1: after the session starts, run \`mise run restart --no-bump --no-git\` ($LANE_REFRESH_STATUS: $LANE_REFRESH_FROM -> $LANE_REFRESH_TO)" >&2

# shellcheck source=_cli_launch.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_cli_launch.sh"
# shellcheck source=_lane_cleanup.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lane_cleanup.sh"

lane_run_with_cleanup systemd-inhibit \
  --what=sleep:idle \
  --who="lane1" \
  --why="Lane 1 $lane_agent_display session" \
  --mode=block \
  "${cli_args[@]}"
