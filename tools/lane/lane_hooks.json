{
  "schema": 1,
  "disableAllHooks": false,
  "lane_only": [
    "block_lane2_status_claims.py",
    "deny_lane3_ae_self_post.py",
    "require_ci_plan.py",
    "grant_ci_plan_override.py",
    "grant_loop_override.py",
    "tasklist_hold.py",
    "record_tasklist_post.py",
    "tier_model_trigger_check.py",
    "tier_downshift_reminder.py",
    "memory_fold_notice.py",
    "lane_launch_notice.py"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane1_status_claims.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane2_status_claims.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_irreversible_ops.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/batch_gate.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/deny_lane3_ae_self_post.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/mypy_cwd_trap.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_inline_prose.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_data_migration_close.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_missing_preclose_inspection.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_route_tightened_merge.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_gate_and_write_same_command.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_undetermined_phase_close.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_stale_script_execution.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/lane3_cloud_cli_policy.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_raw_board_scan.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_unbounded_poll.py\""
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/block_blind_repeat.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/compaction_reload_probe.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane1_status_claims.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor|CronCreate|Skill|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_belt_arming.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/deny_retired_belt_sweep.py\"; [ -f \"$f\" ] && python3 \"$f\" || true"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Write|Edit|MultiEdit|NotebookEdit|CronCreate|ScheduleWakeup|RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/auto_ae_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/deny_cross_session_contact.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/require_ci_plan.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/gate_feedback_memory_write.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "CronCreate|CronDelete",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_belt_arming.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/remind_gate_readiness_sweep.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_tasklist_post.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/expand_lane_shorthand.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/grant_loop_override.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/auto_ae_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_model_trigger_check.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/grant_ci_plan_override.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_model_stop_backstop.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tier_downshift_reminder.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/claim_selfref_shadow.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/enforce_handoff_owed.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/require_probed_operator_commands.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_session_model.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/compaction_marker.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/belt_wakeup.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/lane_launch_notice.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/memory_fold_notice.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_tasklist_post.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/record_failed_command.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/tasklist_hold.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
