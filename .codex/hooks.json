{
  "description": "Codex command guards for Lane 2 raw-post enforcement (harmonic-forge#371) and Lane 3 AE/gate-readiness-sweep self-authorization (harmonic-forge#216/#407). harmonic-forge itself has no per-repo gate_codex_tool.py wrapper (unlike HRSE2) -- the canonical hook modules are wired directly, the same way HRSE2's hooks.json already does for model_tier_gate.py.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/block_lane2_status_claims.py\"",
            "timeout": 5,
            "statusMessage": "Checking Lane 2 posting integrity"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/deny_lane3_ae_self_post.py\"",
            "timeout": 5,
            "statusMessage": "Checking Lane 3 AE/sweep self-authorization"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking model tier for this issue"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/enforce_gate_ci_on_raw_post.py\"",
            "timeout": 30,
            "statusMessage": "Checking gate-report CI coverage (harmonic-forge#565)"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/lane3_codex_write_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Lane 3 write scope (harmonic-forge#644)"
          },
          {
            "type": "command",
            "command": "python3 \"${PWD}/tools/hooks/block_missing_preclose_inspection.py\"",
            "timeout": 10,
            "statusMessage": "Checking pre-close inspection (harmonic-forge#778)"
          },
          {
            "type": "command",
            "command": "python3 \"${PWD}/tools/hooks/batch_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking BATCH authorization (harmonic-forge#778)"
          },
          {
            "type": "command",
            "command": "python3 \"${PWD}/tools/gh/block_closing_keywords.py\"",
            "timeout": 10,
            "statusMessage": "Checking closing-keyword gate (harmonic-forge#778)"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/harmonic-forge/tools/hooks/auto_ae_toggle.py\"; [ -f \"$f\" ] && python3 \"$f\" || true"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/model_tier_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking model tier for this issue"
          },
          {
            "type": "command",
            "command": "python3 \"${HOME}/harmonic-forge/tools/hooks/lane3_codex_write_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Lane 3 write scope (harmonic-forge#644)"
          }
        ]
      }
    ]
  }
}
